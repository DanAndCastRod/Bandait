# Bandait Follower - Environment Variables
# Copy to .env.local for local development. Never commit real keys.

# Leader WebSocket URL (reference only; the app connects to the IP/port typed
# in the connect screen or read from the stage QR).
VITE_LEADER_URL=ws://localhost:4040

# Optional cloud profile (Google sign-in through Supabase). Leave BOTH empty to
# build without cloud features: the "VINCULAR CUENTA GOOGLE" button is hidden
# and the musician profile stays local to the device.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

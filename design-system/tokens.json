{
  "name": "Bandait OLED Noir & Neon",
  "version": "2.0.0",
  "colors": {
    "bg-primary": "#000000",
    "bg-surface": "#0A0A0A",
    "bg-elevated": "#141414",
    "text-primary": "#F0F0F0",
    "text-secondary": "#666666",
    "text-disabled": "#333333",
    "accent-active": "#00FFFF",
    "accent-success": "#CCFF00",
    "accent-warning": "#FFAA00",
    "accent-danger": "#FF0000",
    "accent-special": "#FF00FF"
  },
  "typography": {
    "font-ui": "Inter, system-ui, sans-serif",
    "font-mono": "JetBrains Mono, Consolas, monospace",
    "sizes": {
      "xs": "11px",
      "sm": "12px",
      "base": "14px",
      "lg": "16px",
      "xl": "24px",
      "2xl": "32px",
      "3xl": "48px",
      "4xl": "64px",
      "5xl": "96px",
      "6xl": "128px"
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px"
  },
  "radii": {
    "sm": "2px",
    "base": "4px",
    "lg": "8px"
  },
  "rules": {
    "stage-mode": "Only bg-primary, text-primary, accent-active, accent-success. Zero distractions.",
    "bpm-font": "Always JetBrains Mono Bold. Never proportional.",
    "min-touch": "56x56dp for all interactive elements.",
    "beacon-daltonism": "Combine color + shape (circle/warning=triangle/critical=cross)."
  }
}

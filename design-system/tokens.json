{
  "name": "Bandait Grafito",
  "version": "3.0.0",
  "colors": {
    "bg-primary": "#15181C",
    "bg-surface": "#1B1F24",
    "bg-elevated": "#232830",
    "border": "#2E343D",
    "text-primary": "#D5DAE0",
    "text-secondary": "#8E97A3",
    "text-muted": "#7C8591",
    "text-disabled": "#4A525D",
    "accent-active": "#5CC8C2",
    "accent-success": "#B8CF7A",
    "accent-warning": "#D9A24E",
    "accent-danger": "#D96459",
    "accent-special": "#B48EDB",
    "accent-cobalt": "#7AA5D6",
    "on-accent": "#15181C"
  },
  "typography": {
    "font-ui": "Inter, system-ui, sans-serif",
    "font-mono": "JetBrains Mono, Consolas, monospace",
    "sizes": {
      "xs": "11px",
      "sm": "12px",
      "base": "14px",
      "lg": "16px",
      "xl": "24px",
      "2xl": "32px",
      "3xl": "48px",
      "4xl": "64px",
      "5xl": "96px",
      "6xl": "128px"
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px"
  },
  "radii": {
    "sm": "2px",
    "base": "4px",
    "lg": "8px"
  },
  "rules": {
    "stage-mode": "Only bg-primary, text-primary, accent-active, accent-success. Zero distractions.",
    "bpm-font": "Always JetBrains Mono Bold. Never proportional.",
    "min-touch": "56x56dp for all interactive elements.",
    "beacon-daltonism": "Combine color + shape (circle/warning=triangle/critical=cross).",
    "contrast": "No pure black or saturated neon: text >= WCAG AA, no color pair above ~14:1 (halation on dark stages). Text on an accent fill uses on-accent.",
    "legacy": "v2.0 OLED Noir & Neon (#000000, #00FFFF, #CCFF00) retired on 2026-10-30; the follower keeps it only as optional themes."
  }
}

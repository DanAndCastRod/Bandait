{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Song",
  "description": "Song library entity (leader database / hub). Not sent as-is on the v3 wire: the session carries SetlistEntry objects (session_state.json#/definitions/SetlistEntry).",
  "type": "object",
  "required": [
    "id",
    "title",
    "bpm"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "bpm": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "key": {
      "type": "string",
      "description": "Musical key signature (e.g. 'Em', 'F#')."
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "bars"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "bars": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "lyrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "time",
          "text"
        ],
        "properties": {
          "time": {
            "type": "number",
            "description": "Offset in seconds from song start."
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "audio_path": {
      "type": [
        "string",
        "null"
      ],
      "description": "Local or network path to backing track audio file."
    }
  },
  "additionalProperties": false,
  "$id": "song.json"
}

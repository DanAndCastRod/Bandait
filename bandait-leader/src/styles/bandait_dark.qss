/*
 * Bandait DAW — Estilos Profesionales OLED Noir & Neon
 * Paleta: #000000 fondo, #00FFFF cyan, #CCFF00 lime, #FF0000 danger
 * Tipografía: Inter (UI), JetBrains Mono (números)
 */

/* === BASE === */
QMainWindow, QWidget, QFrame, QTabWidget::pane {
    background-color: #000000;
    color: #F0F0F0;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 12px;
    border: none;
}

QLabel {
    color: #F0F0F0;
    background: transparent;
}

/* === PANELES === */
QFrame#panel, QWidget#panel {
    background-color: #0A0A0A;
    border: 1px solid #1E1E1E;
    border-radius: 4px;
}

QFrame#titleBar {
    background-color: #0A0A0A;
    border-bottom: 1px solid #1E1E1E;
}

QFrame#separator_v {
    background: #1E1E1E;
    max-width: 1px;
    min-width: 1px;
}

/* === BOTONES === */
QPushButton {
    background: transparent;
    border: 1px solid #333333;
    color: #666666;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 12px;
    min-height: 28px;
}

QPushButton:hover {
    border-color: #00FFFF;
    color: #00FFFF;
}

QPushButton:pressed {
    background: #00FFFF;
    color: #000000;
}

QPushButton:disabled {
    border-color: #1E1E1E;
    color: #333333;
}

/* Botón primario (Play, agregar) */
QPushButton#primary {
    border: 1px solid #00FFFF;
    color: #00FFFF;
}

QPushButton#primary:hover {
    background: rgba(0, 255, 255, 20);
}

QPushButton#primary:pressed {
    background: #00FFFF;
    color: #000000;
}

/* Toggle buttons (Mute, Solo, Loop) */
QPushButton#toggle {
    border: 1px solid #666666;
    color: #666666;
    font-size: 10px;
    font-weight: bold;
    min-width: 28px;
    min-height: 24px;
    padding: 2px;
}

QPushButton#toggle:checked {
    background: #00FFFF;
    border-color: #00FFFF;
    color: #000000;
}

QPushButton#toggle:checked[id="mute"] {
    background: #FF0000;
    border-color: #FF0000;
}

QPushButton#toggle:checked[id="solo"] {
    background: #CCFF00;
    border-color: #CCFF00;
}

/* Transport buttons */
QPushButton#transport {
    min-width: 56px;
    min-height: 56px;
    border-radius: 8px;
    font-size: 20px;
    font-weight: bold;
}

QPushButton#transport[id="play"] {
    min-width: 72px;
    min-height: 72px;
    font-size: 28px;
    border: 2px solid #CCFF00;
    color: #CCFF00;
}

QPushButton#transport[id="play"]:checked,
QPushButton#transport[id="play"]:hover {
    background: #CCFF00;
    color: #000000;
}

QPushButton#transport[id="rec"] {
    border: 2px solid #FF0000;
    color: #FF0000;
    border-radius: 50%;
}

QPushButton#transport[id="rec"]:checked,
QPushButton#transport[id="rec"]:hover {
    background: #FF0000;
    color: #000000;
}

QPushButton#transport[id="stop"] {
    border: 2px solid #FF0000;
    color: #FF0000;
}

QPushButton#transport[id="stop"]:hover {
    background: #FF0000;
    color: #000000;
}

/* === SLIDERS === */
QSlider::groove:vertical {
    background: #1E1E1E;
    width: 6px;
    border-radius: 3px;
}

QSlider::handle:vertical {
    background: #00FFFF;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 2px;
}

QSlider::sub-page:vertical {
    background: #00FFFF;
    border-radius: 3px;
}

QSlider::groove:horizontal {
    background: #1E1E1E;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #00FFFF;
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #00FFFF;
    border-radius: 2px;
}

/* === COMBOBOX === */
QComboBox {
    background: #0A0A0A;
    border: 1px solid #1E1E1E;
    color: #F0F0F0;
    padding: 4px 8px;
    min-height: 24px;
    border-radius: 2px;
}

QComboBox::drop-down {
    width: 20px;
    border-left: 1px solid #1E1E1E;
}

QComboBox QAbstractItemView {
    background: #0A0A0A;
    color: #F0F0F0;
    selection-background-color: #00FFFF;
    selection-color: #000000;
    border: 1px solid #1E1E1E;
}

/* === TABS === */
QTabWidget::tab-bar {
    left: 0;
}

QTabBar::tab {
    background: #0A0A0A;
    color: #666666;
    border: 1px solid #1E1E1E;
    border-bottom: none;
    padding: 8px 16px;
    margin-right: 2px;
    font-size: 12px;
    font-weight: bold;
}

QTabBar::tab:hover {
    color: #F0F0F0;
    background: #141414;
}

QTabBar::tab:selected {
    background: #000000;
    color: #00FFFF;
    border-top: 2px solid #00FFFF;
    border-bottom: 1px solid #000000;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

/* === SCROLLBARS === */
QScrollBar:vertical {
    background: #0A0A0A;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #333333;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #00FFFF;
}

QScrollBar:horizontal {
    background: #0A0A0A;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #333333;
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: #00FFFF;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}

/* === LINE EDITS === */
QLineEdit {
    background: #0A0A0A;
    border: 1px solid #1E1E1E;
    color: #F0F0F0;
    padding: 6px 8px;
    border-radius: 2px;
}

QLineEdit:focus {
    border-color: #00FFFF;
}

/* === LIST WIDGET === */
QListWidget {
    background: #0A0A0A;
    border: 1px solid #1E1E1E;
    color: #F0F0F0;
    outline: none;
}

QListWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #1E1E1E;
}

QListWidget::item:hover {
    background: #141414;
}

QListWidget::item:selected {
    background: rgba(0, 255, 255, 30);
    color: #00FFFF;
    border-left: 3px solid #00FFFF;
}

/* === TABLE === */
QTableWidget {
    background: #0A0A0A;
    border: 1px solid #1E1E1E;
    gridline-color: #1E1E1E;
    color: #F0F0F0;
}

QTableWidget::item {
    padding: 6px 8px;
}

QTableWidget::item:selected {
    background: rgba(0, 255, 255, 30);
    color: #00FFFF;
}

QHeaderView::section {
    background: #0A0A0A;
    color: #666666;
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid #1E1E1E;
    font-weight: bold;
    font-size: 11px;
}

QHeaderView::section:hover {
    color: #F0F0F0;
}

/* === SPLITTER === */
QSplitter::handle {
    background: #1E1E1E;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* === STATUS BAR === */
QStatusBar {
    background: #0A0A0A;
    border-top: 1px solid #1E1E1E;
    color: #666666;
    font-size: 11px;
}

QStatusBar::item {
    border: none;
}

/* === TOOLTIP === */
QToolTip {
    background: #141414;
    color: #F0F0F0;
    border: 1px solid #333333;
    padding: 4px 8px;
    font-size: 11px;
}

/* === MENU BAR === */
QMenuBar {
    background: #0A0A0A;
    color: #F0F0F0;
    border-bottom: 1px solid #1E1E1E;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
}

QMenuBar::item:hover {
    background: #141414;
    color: #00FFFF;
}

QMenu {
    background: #0A0A0A;
    border: 1px solid #1E1E1E;
    color: #F0F0F0;
}

QMenu::item {
    padding: 6px 24px;
}

QMenu::item:hover {
    background: rgba(0, 255, 255, 30);
    color: #00FFFF;
}

QMenu::separator {
    height: 1px;
    background: #1E1E1E;
    margin: 4px 8px;
}

/* === DIALOGS === */
QDialog {
    background: #000000;
    border: 1px solid #1E1E1E;
}

QDialog QPushButton {
    min-width: 80px;
    min-height: 32px;
}

/* === PROGRESS BAR === */
QProgressBar {
    background: #0A0A0A;
    border: 1px solid #1E1E1E;
    border-radius: 2px;
    text-align: center;
    color: #666666;
}

QProgressBar::chunk {
    background: #00FFFF;
    border-radius: 2px;
}

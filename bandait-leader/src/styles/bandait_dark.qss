/*
  Bandait DAW — Estilo Grafito (src/ui/theme.py)
  Paleta profesional tipo Ableton/Studio One
*/

/* ===== BASE ===== */
QMainWindow, QWidget, QDialog {
    background-color: #15181C;
    color: #D5DAE0;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
}

QFrame#panel {
    background-color: #1B1F24;
    border: 1px solid #262C34;
    border-radius: 4px;
}

QFrame#separator_v {
    background-color: #262C34;
    max-width: 1px;
    min-width: 1px;
}

QFrame#separator_h {
    background-color: #262C34;
    max-height: 1px;
    min-height: 1px;
}

/* ===== TÍTULOS ===== */
QLabel#title {
    font-family: "Inter", sans-serif;
    font-size: 18px;
    font-weight: bold;
    color: #5CC8C2;
    letter-spacing: 1px;
}

QLabel#subtitle {
    font-family: "Inter", sans-serif;
    font-size: 12px;
    color: #7C8591;
}

/* ===== DISPLAYS NUMÉRICOS ===== */
QLabel#timeDisplay {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 28px;
    font-weight: bold;
    color: #B8CF7A;
    background-color: #1B1F24;
    border: 1px solid #262C34;
    border-radius: 4px;
    padding: 8px 16px;
    letter-spacing: 2px;
}

QLabel#bpmDisplay {
    font-family: "JetBrains Mono", monospace;
    font-size: 32px;
    font-weight: bold;
    color: #5CC8C2;
    background-color: #1B1F24;
    border: 1px solid #262C34;
    border-radius: 4px;
    padding: 4px 12px;
}

/* ===== BOTONES =====
   Todo QPushButton se ve como botón: fondo elevado, borde visible y texto claro.
   Variantes por objectName: primary (la acción del momento), danger (borrar),
   success (cargar en vivo). Las reglas #transport y #toggle de abajo ganan por
   especificidad. tests/test_library_controls.py exige una regla aquí para cada
   objectName que el código ponga en un QPushButton. */
QPushButton {
    background-color: #232830;
    border: 1px solid #4A525D;
    border-radius: 4px;
    color: #D5DAE0;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 16px;
    min-height: 22px;
}

QPushButton:hover {
    border-color: #5CC8C2;
    color: #5CC8C2;
}

QPushButton:pressed {
    background-color: #5CC8C2;
    border-color: #5CC8C2;
    color: #15181C;
}

QPushButton:focus {
    border-color: #5CC8C2;
}

QPushButton:disabled {
    background-color: #1B1F24;
    border-color: #2B313A;
    color: #5A626E;
}

QPushButton#primary {
    background-color: #5CC8C2;
    border-color: #5CC8C2;
    color: #15181C;
}

QPushButton#primary:hover {
    background-color: #9BE0DC;
    border-color: #9BE0DC;
    color: #15181C;
}

QPushButton#primary:pressed {
    background-color: #3E9F9A;
    border-color: #3E9F9A;
}

QPushButton#primary:disabled {
    background-color: #1B1F24;
    border-color: #2B313A;
    color: #5A626E;
}

QPushButton#danger {
    background-color: #2A1D1D;
    border-color: #D96459;
    color: #E68A80;
}

QPushButton#danger:hover {
    background-color: #D96459;
    color: #15181C;
}

QPushButton#danger:disabled {
    background-color: #1B1F24;
    border-color: #2B313A;
    color: #5A626E;
}

QPushButton#success {
    background-color: #1E2318;
    border-color: #B8CF7A;
    color: #B8CF7A;
}

QPushButton#success:hover {
    background-color: #B8CF7A;
    color: #15181C;
}

QPushButton#success:disabled {
    background-color: #1B1F24;
    border-color: #2B313A;
    color: #5A626E;
}

/* ===== BOTONES DE TRANSPORTE ===== */
QPushButton#transport {
    min-width: 56px;
    min-height: 56px;
    border-radius: 8px;
    font-size: 20px;
    font-weight: bold;
    border: 2px solid;
    background: transparent;
    padding: 0;
    transition: all 0.15s ease;
}

QPushButton#transport[id="play"] {
    border-color: #B8CF7A;
    color: #B8CF7A;
    min-width: 72px;
    min-height: 72px;
    font-size: 28px;
}

QPushButton#transport[id="play"]:checked,
QPushButton#transport[id="play"]:hover {
    background: #B8CF7A;
    color: #15181C;
}

QPushButton#transport[id="stop"] {
    border-color: #D96459;
    color: #D96459;
}

QPushButton#transport[id="stop"]:hover {
    background: #D96459;
    color: #15181C;
}

QPushButton#transport[id="rec"] {
    border-color: #D96459;
    color: #D96459;
    border-radius: 50%;
}

QPushButton#transport[id="rec"]:checked,
QPushButton#transport[id="rec"]:hover {
    background: #D96459;
    color: #15181C;
}

/* ===== BOTONES TOGGLE ===== */
QPushButton#toggle {
    min-width: 28px;
    min-height: 24px;
    border: 1px solid #7C8591;
    color: #7C8591;
    border-radius: 2px;
    font-size: 10px;
    font-weight: bold;
    padding: 2px;
}

QPushButton#toggle[id="mute"]:checked {
    background: #D96459;
    border-color: #D96459;
    color: #15181C;
}

QPushButton#toggle[id="solo"]:checked {
    background: #B8CF7A;
    border-color: #B8CF7A;
    color: #15181C;
}

QPushButton#toggle:hover {
    border-color: #5CC8C2;
    color: #5CC8C2;
}

/* ===== SLIDERS ===== */
QSlider::groove:vertical {
    background: #262C34;
    width: 6px;
    border-radius: 3px;
}

QSlider::handle:vertical {
    background: #5CC8C2;
    height: 16px;
    width: 16px;
    margin: -5px 0;
    border-radius: 2px;
}

QSlider::sub-page:vertical {
    background: #5CC8C2;
    border-radius: 3px;
}

QSlider::groove:horizontal {
    background: #262C34;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #5CC8C2;
    width: 12px;
    height: 12px;
    margin: 0 -4px;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #5CC8C2;
    border-radius: 2px;
}

/* ===== COMBOBOX ===== */
QComboBox {
    background: #1B1F24;
    border: 1px solid #262C34;
    color: #D5DAE0;
    font-size: 12px;
    padding: 4px 8px;
    border-radius: 4px;
}

QComboBox::drop-down {
    width: 20px;
    border-left: 1px solid #262C34;
}

QComboBox QAbstractItemView {
    background: #1B1F24;
    color: #D5DAE0;
    selection-background-color: #5CC8C2;
    selection-color: #15181C;
    border: 1px solid #262C34;
}

/* ===== TAB BAR ===== */
QTabWidget::pane {
    border: none;
    background: #15181C;
}

QTabBar::tab {
    background: #1B1F24;
    color: #7C8591;
    padding: 10px 20px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 12px;
    font-weight: 600;
}

QTabBar::tab:selected {
    color: #5CC8C2;
    border-bottom: 2px solid #5CC8C2;
    background: #232830;
}

QTabBar::tab:hover:!selected {
    color: #D5DAE0;
    background: #232830;
}

/* ===== SCROLLBAR ===== */
QScrollBar:vertical {
    background: #1B1F24;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #363D47;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #5A626E;
}

QScrollBar:horizontal {
    background: #1B1F24;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #363D47;
    border-radius: 4px;
    min-width: 30px;
}

/* ===== MENÚ ===== */
QMenuBar {
    background: #1B1F24;
    color: #D5DAE0;
    border-bottom: 1px solid #262C34;
}

QMenuBar::item:selected {
    background: #232830;
    color: #5CC8C2;
}

QMenu {
    background: #1B1F24;
    color: #D5DAE0;
    border: 1px solid #262C34;
}

QMenu::item:selected {
    background: #232830;
    color: #5CC8C2;
}

/* ===== SPLITTER ===== */
QSplitter::handle {
    background: #262C34;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* ===== STATUS BAR ===== */
QStatusBar {
    background: #1B1F24;
    color: #7C8591;
    border-top: 1px solid #262C34;
    font-size: 11px;
}

QStatusBar::item {
    border: none;
}

/* ===== INPUTS ===== */
QLineEdit {
    background: #1B1F24;
    border: 1px solid #262C34;
    color: #D5DAE0;
    padding: 6px 10px;
    border-radius: 4px;
    font-size: 13px;
}

QLineEdit:focus {
    border-color: #5CC8C2;
}

/* ===== CAMPOS DE LOS EDITORES ===== */
QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QDateTimeEdit {
    background: #1B1F24;
    border: 1px solid #2E343D;
    color: #D5DAE0;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 13px;
    selection-background-color: #5CC8C2;
    selection-color: #15181C;
}

QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateTimeEdit:focus {
    border-color: #5CC8C2;
}

QCheckBox {
    background: transparent;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #4A525D;
    border-radius: 3px;
    background: #1B1F24;
}

QCheckBox::indicator:checked {
    background: #5CC8C2;
    border-color: #5CC8C2;
}

QDialog QLabel {
    background: transparent;
}

/* ===== LIST VIEW / TABLE ===== */
QListView, QTableView {
    background: #1B1F24;
    border: 1px solid #262C34;
    color: #D5DAE0;
    selection-background-color: rgba(92, 200, 194, 0.2);
    selection-color: #D5DAE0;
    outline: none;
}

QListView::item:selected, QTableView::item:selected {
    background: rgba(92, 200, 194, 0.15);
    border: 1px solid #5CC8C2;
}

QHeaderView::section {
    background: #232830;
    color: #8E97A3;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #262C34;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* ===== TOOLTIP ===== */
QToolTip {
    background: #232830;
    color: #D5DAE0;
    border: 1px solid #5CC8C2;
    padding: 6px 10px;
    border-radius: 4px;
    font-size: 12px;
}

/* ===== PROGRESS BAR ===== */
QProgressBar {
    background: #1B1F24;
    border: 1px solid #262C34;
    border-radius: 3px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background: #5CC8C2;
    border-radius: 2px;
}

/* Escenario: conmutador ACORDES / LETRA del prompter */
QPushButton#prompterMode {
    background-color: #1B1F24;
    border: 1px solid #2E343D;
    color: #8E97A3;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton#prompterMode:hover {
    border-color: #5CC8C2;
    color: #D5DAE0;
}

QPushButton#prompterMode:pressed {
    background-color: #232830;
}

QPushButton#prompterMode:focus {
    border-color: #5CC8C2;
}

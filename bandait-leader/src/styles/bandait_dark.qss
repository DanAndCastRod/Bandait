/*
  Bandait Lider: plantilla de estilos Grafito.
  Cada nombre con arroba (por ejemplo @BG o @SIZE_TITLE) se reemplaza al arrancar con su valor
  de src/ui/theme.py (theme.render_qss). No escribir colores, fuentes ni tamanos literales:
  agregar un token en theme.py. La familia y el tamano base van en QApplication.setFont;
  una regla QWidget { font-size } pisaria todo setFont.
*/

/* ===== BASE ===== */
/* Solo las ventanas pintan el fondo: si QWidget lo pintara, cada etiqueta dibujaria un
   rectangulo oscuro sobre los paneles (visto en las capturas de 2.3). */
QMainWindow, QDialog, QStackedWidget, QScrollArea > QWidget > QWidget {
    background-color: @BG;
    color: @FG;
}
QWidget { color: @FG; }

QFrame#panel {
    background-color: @SURFACE;
    border: 1px solid @RAISED;
    border-radius: 4px;
}

QFrame#separator_v {
    background-color: @RAISED;
    max-width: 1px;
    min-width: 1px;
}

QFrame#separator_h {
    background-color: @RAISED;
    max-height: 1px;
    min-height: 1px;
}

/* ===== TÍTULOS ===== */
QLabel#title {
    font-family: @FONT_UI_STACK;
    font-size: 18px;
    font-weight: bold;
    color: @ACTIVE;
    letter-spacing: 1px;
}

QLabel#subtitle {
    font-family: @FONT_UI_STACK;
    font-size: 12px;
    color: @MUTED;
}

/* ===== DISPLAYS NUMÉRICOS ===== */
QLabel#timeDisplay {
    font-family: @FONT_MONO_STACK;
    font-size: 28px;
    font-weight: bold;
    color: @SUCCESS;
    background-color: @SURFACE;
    border: 1px solid @RAISED;
    border-radius: 4px;
    padding: 8px 16px;
    letter-spacing: 2px;
}

QLabel#bpmDisplay {
    font-family: @FONT_MONO_STACK;
    font-size: 32px;
    font-weight: bold;
    color: @ACTIVE;
    background-color: @SURFACE;
    border: 1px solid @RAISED;
    border-radius: 4px;
    padding: 4px 12px;
}

/* ===== BOTONES =====
   Todo QPushButton se ve como botón: fondo elevado, borde visible y texto claro.
   Variantes por objectName: primary (la acción del momento), danger (borrar),
   success (cargar en vivo). Las reglas #transport y #toggle de abajo ganan por
   especificidad. tests/test_library_controls.py exige una regla aquí para cada
   objectName que el código ponga en un QPushButton. */
QPushButton {
    background-color: @ELEVATED;
    border: 1px solid @FAINT;
    border-radius: 4px;
    color: @FG;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 16px;
    min-height: 22px;
}

QPushButton:hover {
    border-color: @ACTIVE;
    color: @ACTIVE;
}

QPushButton:pressed {
    background-color: @ACTIVE;
    border-color: @ACTIVE;
    color: @BG;
}

QPushButton:focus {
    border-color: @ACTIVE;
}

QPushButton:disabled {
    background-color: @SURFACE;
    border-color: @RAISED_HOVER;
    color: @FAINT_STRONG;
}

QPushButton#primary {
    background-color: @ACTIVE;
    border-color: @ACTIVE;
    color: @BG;
}

QPushButton#primary:hover {
    background-color: @ACTIVE_LIGHT;
    border-color: @ACTIVE_LIGHT;
    color: @BG;
}

QPushButton#primary:pressed {
    background-color: @ACTIVE_DEEP;
    border-color: @ACTIVE_DEEP;
}

QPushButton#primary:disabled {
    background-color: @SURFACE;
    border-color: @RAISED_HOVER;
    color: @FAINT_STRONG;
}

QPushButton#danger {
    background-color: @DANGER_BG;
    border-color: @DANGER;
    color: @DANGER_LIGHT;
}

QPushButton#danger:hover {
    background-color: @DANGER;
    color: @BG;
}

QPushButton#danger:disabled {
    background-color: @SURFACE;
    border-color: @RAISED_HOVER;
    color: @FAINT_STRONG;
}

QPushButton#success {
    background-color: @SUCCESS_BG;
    border-color: @SUCCESS;
    color: @SUCCESS;
}

QPushButton#success:hover {
    background-color: @SUCCESS;
    color: @BG;
}

QPushButton#success:disabled {
    background-color: @SURFACE;
    border-color: @RAISED_HOVER;
    color: @FAINT_STRONG;
}

/* ===== BOTONES DE TRANSPORTE ===== */
QPushButton#transport {
    min-width: 44px;
    min-height: 40px;
    border-radius: @RADIUS;
    font-size: 16px;
    font-weight: bold;
    border: 1.5px solid @LINE_STRONG;
    background: transparent;
    padding: 0;
}

QPushButton#transport[id="play"] {
    border-color: @SUCCESS;
    color: @SUCCESS;
    background: @SUCCESS_SOFT;
}

QPushButton#transport[id="play"]:checked,
QPushButton#transport[id="play"]:hover {
    background: @SUCCESS;
    color: @BG;
}

QPushButton#transport[id="stop"] {
    border-color: @DANGER;
    color: @DANGER;
}

QPushButton#transport[id="stop"]:hover {
    background: @DANGER;
    color: @BG;
}

QPushButton#transport[id="rec"] {
    border-color: @DANGER;
    color: @DANGER;
}

QPushButton#transport[id="rec"]:checked,
QPushButton#transport[id="rec"]:hover {
    background: @DANGER;
    color: @BG;
}

QFrame[role="beat"] { background-color: @RAISED; border: none; border-radius: 2px; }
QFrame[role="beat"][state="on"] { background-color: @SUCCESS; }
QFrame[role="beat"][state="one"] { background-color: @ACTIVE; }

/* ===== BOTONES TOGGLE ===== */
QPushButton#toggle {
    min-width: 28px;
    min-height: 24px;
    border: 1px solid @MUTED;
    color: @MUTED;
    border-radius: 2px;
    font-size: 10px;
    font-weight: bold;
    padding: 2px;
}

QPushButton#toggle[id="mute"]:checked {
    background: @DANGER;
    border-color: @DANGER;
    color: @BG;
}

QPushButton#toggle[id="solo"]:checked {
    background: @SUCCESS;
    border-color: @SUCCESS;
    color: @BG;
}

QPushButton#toggle:hover {
    border-color: @ACTIVE;
    color: @ACTIVE;
}

/* ===== SLIDERS ===== */
QSlider::groove:vertical {
    background: @RAISED;
    width: 6px;
    border-radius: 3px;
}

QSlider::handle:vertical {
    background: @ACTIVE;
    height: 16px;
    width: 16px;
    margin: -5px 0;
    border-radius: 2px;
}

QSlider::sub-page:vertical {
    background: @ACTIVE;
    border-radius: 3px;
}

QSlider::groove:horizontal {
    background: @RAISED;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: @ACTIVE;
    width: 12px;
    height: 12px;
    margin: 0 -4px;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: @ACTIVE;
    border-radius: 2px;
}

/* ===== COMBOBOX ===== */
QComboBox {
    background: @SURFACE;
    border: 1px solid @RAISED;
    color: @FG;
    font-size: 12px;
    padding: 4px 8px;
    border-radius: 4px;
}

QComboBox::drop-down {
    width: 20px;
    border-left: 1px solid @RAISED;
}

QComboBox QAbstractItemView {
    background: @SURFACE;
    color: @FG;
    selection-background-color: @ACTIVE;
    selection-color: @BG;
    border: 1px solid @RAISED;
}

/* ===== TAB BAR ===== */
QTabWidget::pane {
    border: none;
    background: @BG;
}

QTabBar::tab {
    background: @SURFACE;
    color: @MUTED;
    padding: 10px 20px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 12px;
    font-weight: 600;
}

QTabBar::tab:selected {
    color: @ACTIVE;
    border-bottom: 2px solid @ACTIVE;
    background: @ELEVATED;
}

QTabBar::tab:hover:!selected {
    color: @FG;
    background: @ELEVATED;
}

/* ===== SCROLLBAR ===== */
QScrollBar:vertical {
    background: @SURFACE;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: @LINE_STRONG;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: @FAINT_STRONG;
}

QScrollBar:horizontal {
    background: @SURFACE;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: @LINE_STRONG;
    border-radius: 4px;
    min-width: 30px;
}

/* ===== MENÚ ===== */
QMenuBar {
    background: @SURFACE;
    color: @FG;
    border-bottom: 1px solid @RAISED;
}

QMenuBar::item:selected {
    background: @ELEVATED;
    color: @ACTIVE;
}

QMenu {
    background: @SURFACE;
    color: @FG;
    border: 1px solid @RAISED;
}

QMenu::item:selected {
    background: @ELEVATED;
    color: @ACTIVE;
}

/* ===== SPLITTER ===== */
QSplitter::handle {
    background: @RAISED;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* ===== STATUS BAR ===== */
QStatusBar {
    background: @SURFACE;
    color: @MUTED;
    border-top: 1px solid @RAISED;
    font-size: 11px;
}

QStatusBar::item {
    border: none;
}

/* ===== INPUTS ===== */
QLineEdit {
    background: @SURFACE;
    border: 1px solid @RAISED;
    color: @FG;
    padding: 6px 10px;
    border-radius: 4px;
    font-size: 13px;
}

QLineEdit:focus {
    border-color: @ACTIVE;
}

/* ===== CAMPOS DE LOS EDITORES ===== */
QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QDateTimeEdit {
    background: @SURFACE;
    border: 1px solid @LINE;
    color: @FG;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 13px;
    selection-background-color: @ACTIVE;
    selection-color: @BG;
}

QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateTimeEdit:focus {
    border-color: @ACTIVE;
}

QCheckBox {
    background: transparent;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid @FAINT;
    border-radius: 3px;
    background: @SURFACE;
}

QCheckBox::indicator:checked {
    background: @ACTIVE;
    border-color: @ACTIVE;
}

QDialog QLabel {
    background: transparent;
}

/* ===== LIST VIEW / TABLE ===== */
QListView, QTableView {
    background: @SURFACE;
    border: 1px solid @RAISED;
    color: @FG;
    selection-background-color: @ACTIVE_GLOW;
    selection-color: @FG;
    outline: none;
}

QListView::item:selected, QTableView::item:selected {
    background: @ACTIVE_SOFT;
    border: 1px solid @ACTIVE;
}

QHeaderView::section {
    background: @ELEVATED;
    color: @SECONDARY;
    padding: 8px;
    border: none;
    border-bottom: 1px solid @RAISED;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* ===== TOOLTIP ===== */
QToolTip {
    background: @ELEVATED;
    color: @FG;
    border: 1px solid @ACTIVE;
    padding: 6px 10px;
    border-radius: 4px;
    font-size: 12px;
}

/* ===== PROGRESS BAR ===== */
QProgressBar {
    background: @SURFACE;
    border: 1px solid @RAISED;
    border-radius: 3px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background: @ACTIVE;
    border-radius: 2px;
}

/* Escenario: conmutador ACORDES / LETRA del prompter */
QPushButton#prompterMode {
    background-color: @SURFACE;
    border: 1px solid @LINE;
    color: @SECONDARY;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton#prompterMode:hover {
    border-color: @ACTIVE;
    color: @FG;
}

QPushButton#prompterMode:pressed {
    background-color: @ELEVATED;
}

QPushButton#prompterMode:focus {
    border-color: @ACTIVE;
}

/* ======================================================================
   Componentes 2.3 (src/ui/components.py). Se estilan por propiedades
   dinamicas: role, kind, variant, tag, state. Nada de setStyleSheet inline.
   ====================================================================== */

QFrame[role="panel"] {
    background-color: @SURFACE;
    border: 1px solid @LINE;
    border-radius: @RADIUS_LG;
}
QFrame[role="panel-head"] {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid @LINE;
}
QFrame[role="rail"], QFrame[role="topbar"], QFrame[role="statusbar"] {
    background-color: @SURFACE;
    border: none;
}
QFrame[role="rail"] { border-right: 1px solid @LINE; }
QFrame[role="topbar"] { border-bottom: 1px solid @LINE; }
QFrame[role="statusbar"] { border-top: 1px solid @LINE; }
QFrame[role="divider"] { background-color: @LINE; border: none; max-width: 1px; min-width: 1px; }
QFrame[role="row"] { background-color: transparent; border: none; border-bottom: 1px solid @LINE; }
QFrame[role="row"][state="active"] { background-color: @ACTIVE_SOFT; }
QFrame[role="callout-ai"] {
    background-color: @SPECIAL_SOFT;
    border: 1px solid @SPECIAL;
    border-radius: @RADIUS_LG;
}

/* Riel lateral */
QPushButton[role="nav"] {
    background-color: transparent;
    border: none;
    border-radius: @RADIUS;
    color: @SECONDARY;
    font-size: @SIZE_BASE;
    font-weight: 500;
    padding: @SPACE_2 @SPACE_3;
    text-align: left;
}
QPushButton[role="nav"]:hover { color: @FG; background-color: @RAISED; }
QPushButton[role="nav"]:checked { color: @FG_STRONG; background-color: @ACTIVE_SOFT; border-left: 3px solid @ACTIVE; }
QPushButton[role="nav"]:focus { outline: none; border: 1px solid @ACTIVE; }

/* Tipografia */
QLabel[kind="hero"] { font-family: @FONT_MONO_STACK; font-size: @SIZE_HERO; font-weight: 600; color: @ACTIVE; }
QLabel[kind="giant"] { font-family: @FONT_MONO_STACK; font-size: @SIZE_GIANT; font-weight: 600; color: @ACTIVE; }
QLabel[kind="display"] { font-size: @SIZE_DISPLAY; font-weight: 700; color: @FG_STRONG; }
QLabel[kind="heading"] { font-size: @SIZE_HEADING; font-weight: 700; color: @FG_STRONG; }
QLabel[kind="title"] { font-size: @SIZE_TITLE; font-weight: 600; color: @FG_STRONG; }
QLabel[kind="body"] { font-size: @SIZE_BODY; color: @FG; }
QLabel[kind="muted"] { font-size: @SIZE_SMALL; color: @MUTED; }
QLabel[kind="label"] { font-family: @FONT_MONO_STACK; font-size: @SIZE_CAPTION; letter-spacing: 1.5px; color: @MUTED; }
QLabel[kind="panel-title"] { font-family: @FONT_MONO_STACK; font-size: @SIZE_SMALL; font-weight: 600; letter-spacing: 1.5px; color: @SECONDARY; }
QLabel[kind="mono"] { font-family: @FONT_MONO_STACK; font-size: @SIZE_BASE; color: @FG; }
QLabel[kind="readout"] { font-family: @FONT_MONO_STACK; font-size: 26px; font-weight: 600; color: @SUCCESS; }
QLabel[kind="readout-active"] { font-family: @FONT_MONO_STACK; font-size: 26px; font-weight: 600; color: @ACTIVE; }

/* Pildoras y etiquetas de estado */
QLabel[role="pill"] {
    font-family: @FONT_MONO_STACK; font-size: @SIZE_CAPTION; color: @SECONDARY;
    border: 1px solid @LINE; border-radius: 10px; padding: 2px @SPACE_2;
}
QLabel[role="tag"] {
    font-family: @FONT_MONO_STACK; font-size: @SIZE_CAPTION; letter-spacing: 0.6px; color: @SECONDARY;
    border: 1px solid @LINE_STRONG; border-radius: 3px; padding: 1px 6px;
}
QLabel[role="tag"][tag="ok"] { color: @SUCCESS; border-color: @SUCCESS; }
QLabel[role="tag"][tag="act"] { color: @ACTIVE; border-color: @ACTIVE; }
QLabel[role="tag"][tag="warn"] { color: @WARNING; border-color: @WARNING; }
QLabel[role="tag"][tag="danger"] { color: @DANGER; border-color: @DANGER; }
QLabel[role="tag"][tag="ai"] { color: @SPECIAL; border-color: @SPECIAL; }

/* Botones por variante (los objectName primary/danger/success de arriba siguen valiendo) */
QPushButton[variant="secondary"] {
    background-color: transparent; border: 1px solid @LINE_STRONG; color: @FG;
    border-radius: @RADIUS; padding: 6px @SPACE_3; font-weight: 600;
}
QPushButton[variant="secondary"]:hover { border-color: @ACTIVE; color: @FG_STRONG; }
QPushButton[variant="secondary"]:pressed { background-color: @ELEVATED; }
QPushButton[variant="secondary"]:disabled { color: @FAINT; border-color: @LINE; }
QPushButton[variant="primary"] {
    background-color: @ACTIVE; border: 1px solid @ACTIVE; color: @ON_ACCENT;
    border-radius: @RADIUS; padding: 6px @SPACE_3; font-weight: 600;
}
QPushButton[variant="primary"]:hover { background-color: @ACTIVE_HOVER; border-color: @ACTIVE_HOVER; }
QPushButton[variant="primary"]:pressed { background-color: @ACTIVE_DEEP; }
QPushButton[variant="primary"]:disabled { background-color: @RAISED; border-color: @LINE; color: @FAINT; }
QPushButton[variant="ghost"] {
    background-color: transparent; border: 1px solid transparent; color: @SECONDARY;
    border-radius: @RADIUS; padding: 6px @SPACE_3; font-weight: 600;
}
QPushButton[variant="ghost"]:hover { color: @FG; background-color: @RAISED; }
QPushButton[variant="ai"] {
    background-color: transparent; border: 1px solid @SPECIAL; color: @SPECIAL;
    border-radius: @RADIUS; padding: 6px @SPACE_3; font-weight: 600;
}
QPushButton[variant="ai"]:hover { background-color: @SPECIAL_SOFT; }
QPushButton[variant="ai"]:disabled { color: @FAINT; border-color: @LINE; }
QPushButton[variant="panic"] {
    background-color: @DANGER; border: 1px solid @DANGER; color: @ON_ACCENT;
    border-radius: @RADIUS; padding: @SPACE_2 @SPACE_4;
    font-family: @FONT_MONO_STACK; font-weight: 600; letter-spacing: 1px;
}
QPushButton[variant="panic"]:hover { background-color: @DANGER_HOVER; }
QPushButton[variant="panic"]:pressed { background-color: @DANGER_LIGHT; }
QPushButton[variant="chip"] {
    background-color: transparent; border: 1px solid @LINE_STRONG; color: @SECONDARY;
    border-radius: @RADIUS; padding: 4px @SPACE_2; font-family: @FONT_MONO_STACK; font-size: @SIZE_CAPTION;
}
QPushButton[variant="chip"]:hover { color: @FG; border-color: @ACTIVE; }
QPushButton[variant="chip"]:checked { background-color: @ACTIVE; color: @ON_ACCENT; border-color: @ACTIVE; }

/* Barra de titulo, bloque de banda y estado (2.3) */
QFrame#titleBar { background-color: @SURFACE; border: none; border-bottom: 1px solid @LINE; }
QLabel#titleLogo { color: @ACTIVE; }
QPushButton#winbtn, QPushButton#winclose {
    background-color: transparent; border: 1px solid @LINE; border-radius: @RADIUS;
    color: @MUTED; padding: 0; min-height: 0; font-size: @SIZE_BASE;
}
QPushButton#winbtn:hover { border-color: @ACTIVE; color: @ACTIVE; }
QPushButton#winclose:hover { background-color: @DANGER; border-color: @DANGER; color: @ON_ACCENT; }
QFrame[role="brand"] { background-color: transparent; border: none; border-right: 1px solid @LINE; }
QStatusBar { background-color: @SURFACE; border-top: 1px solid @LINE; }
QStatusBar QLabel { padding: 0 @SPACE_2; }
QStatusBar::item { border: none; }

QPushButton[health="ok"], QLabel[health="ok"] { color: @SUCCESS; }
QPushButton[health="warn"], QLabel[health="warn"], QPushButton[health="stale"] { color: @WARNING; }
QPushButton[health="bad"], QLabel[health="bad"] { color: @DANGER_HOVER; }

/* Escenario (2.3) */
QFrame[role="beacon"] { background-color: @SUCCESS; border: none; }
QFrame[role="beacon"][state="bad"] { background-color: @DANGER; }
QFrame[role="divider-h"] { background-color: @LINE; border: none; }
QLabel#setlistNotice { background-color: @WARNING; color: @ON_ACCENT; font-weight: 600; padding: @SPACE_2 @SPACE_4; border-radius: @RADIUS; }
QLabel[kind="section-head"] { font-family: @FONT_MONO_STACK; font-size: @SIZE_BASE; font-weight: 600; letter-spacing: 2px; color: @ACTIVE; }
QLabel[kind="prompter-singer"] { font-size: 40px; font-weight: 700; color: @FG_STRONG; }
QLabel[kind="prompter-musician"] { font-family: @FONT_MONO_STACK; font-size: 28px; font-weight: 600; color: @FG_STRONG; }
QLabel[kind="next"] { font-size: @SIZE_BODY; color: @MUTED; }
QLabel[kind="readout-plain"] { font-family: @FONT_MONO_STACK; font-size: 22px; font-weight: 600; color: @FG; }
QLabel[kind="next-section"] { font-size: 22px; font-weight: 700; color: @SUCCESS; }
QLabel[role="sec"] {
    background-color: @RAISED; color: @MUTED; border-radius: 3px; padding: 0 @SPACE_2;
    font-family: @FONT_MONO_STACK; font-size: @SIZE_CAPTION;
}
QLabel[role="sec"][state="done"] { background-color: @ELEVATED; color: @FAINT; }
QLabel[role="sec"][state="now"] { background-color: @ACTIVE; color: @ON_ACCENT; font-weight: 600; }
QFrame[role="dot"] { border-radius: 4px; background-color: @FAINT; border: none; }
QFrame[role="dot"][health="ok"] { background-color: @SUCCESS; }
QFrame[role="dot"][health="warn"] { background-color: @WARNING; }
QFrame[role="dot"][health="bad"] { background-color: @DANGER; }
QListWidget#setlistRail { background-color: transparent; border: none; font-size: @SIZE_BODY; }
QListWidget#setlistRail::item { padding: @SPACE_2 @SPACE_3; border-bottom: 1px solid @LINE; }

/* Biblioteca (2.3) */
QCheckBox#demoCheck { color: @WARNING; }
QLabel[kind="accent"] { color: @ACTIVE; font-weight: 600; }

/* Tablas: encabezado vertical y esquina sin el gris claro de Qt */
QHeaderView { background-color: @SURFACE; border: none; }
QHeaderView::section:vertical { background-color: @SURFACE; color: @FAINT; border: none; padding: 0 @SPACE_1; }
QTableView QTableCornerButton::section, QTableWidget QTableCornerButton::section { background-color: @SURFACE; border: none; }

/* Tonos de texto (propiedad tone) */
QLabel[tone="muted"] { color: @MUTED; }
QLabel[tone="secondary"] { color: @SECONDARY; }
QLabel[tone="faint"] { color: @FAINT; }
QLabel[tone="fg"] { color: @FG; }
QLabel[tone="active"] { color: @ACTIVE; }
QLabel[tone="success"] { color: @SUCCESS; }
QLabel[tone="warning"] { color: @WARNING; }
QLabel[tone="danger"] { color: @DANGER; }

/* Dialogos (antes DIALOG_QSS en account_login.py) */
QLabel#detail { color: @SECONDARY; }
QLabel#hint { color: @WARNING; border: 1px solid @LINE_STRONG; border-radius: @RADIUS; padding: @SPACE_2; }
QLabel#error { color: @DANGER; }
QProgressBar { background-color: @SURFACE; border: 1px solid @RAISED; max-height: 6px; border-radius: 3px; }
QProgressBar::chunk { background-color: @ACTIVE; }
QListWidget { background-color: @SURFACE; color: @FG; border: 1px solid @RAISED; }
QListWidget::item:selected { background-color: @ACTIVE; color: @ON_ACCENT; }

/* ======================================================================
   Vistas 2.3: Ensayo, Banda y Ajustes (src/ui/views/rehearsal_view.py,
   band_view.py, settings_view.py). Solo reglas por propiedad.
   ====================================================================== */

/* Dentro de un panel las etiquetas y los contenedores no pintan el fondo de la ventana. */
QFrame[role="panel"] QLabel { background-color: transparent; }
QWidget[role="bare"], QScrollArea[role="bare"], QStackedWidget[role="bare"] {
    background-color: transparent;
    border: none;
}

QLabel[kind="readout-strong"] { font-family: @FONT_MONO_STACK; font-size: @SIZE_READOUT; font-weight: 600; color: @FG_STRONG; }
QLabel[kind="strong"] { font-size: @SIZE_BODY; font-weight: 600; color: @FG_STRONG; }
QLabel[kind="warn"] { font-size: @SIZE_SMALL; color: @WARNING; }
QLabel[kind="prompt"] { font-size: @SIZE_PROMPT; color: @FG_STRONG; }

/* Interruptor: un botón chequeable con el estado escrito (se lee sin distinguir colores). */
QPushButton[variant="switch"] {
    background-color: @RAISED; border: 1px solid @LINE_STRONG; color: @SECONDARY;
    border-radius: @RADIUS_PILL; padding: @SPACE_1 @SPACE_3;
    font-family: @FONT_MONO_STACK; font-size: @SIZE_CAPTION; letter-spacing: 1px;
}
QPushButton[variant="switch"]:hover { border-color: @ACTIVE; color: @FG; }
QPushButton[variant="switch"]:checked { background-color: @ACTIVE_SOFT; border-color: @ACTIVE; color: @ACTIVE; }
QPushButton[variant="switch"]:checked:hover { border-color: @ACTIVE_HOVER; color: @ACTIVE_HOVER; }
QPushButton[variant="switch"]:pressed { background-color: @ELEVATED; }
QPushButton[variant="switch"]:disabled { color: @FAINT; border-color: @LINE; }

/* Foco por teclado visible en chips, interruptores y botones secundarios. */
QPushButton[variant="chip"]:focus,
QPushButton[variant="switch"]:focus,
QPushButton[variant="secondary"]:focus,
QPushButton[variant="ghost"]:focus { border-color: @ACTIVE; }
QPushButton[variant="chip"]:pressed { background-color: @ELEVATED; }
QPushButton[variant="chip"]:disabled { color: @FAINT; border-color: @LINE; }
QPushButton[variant="ghost"]:pressed { background-color: @ELEVATED; }
QPushButton[variant="ghost"]:disabled { color: @FAINT; }

/* Tabla de integrantes: filas separadas por una línea, sin rejilla. */
QTableWidget[role="table"] {
    background-color: transparent;
    border: none;
    gridline-color: transparent;
    font-size: @SIZE_BASE;
}
QTableWidget[role="table"]::item {
    padding: 0 @SPACE_2;
    border-bottom: 1px solid @LINE;
}
QTableWidget[role="table"] QHeaderView::section {
    background-color: @SURFACE;
    color: @MUTED;
    font-family: @FONT_MONO_STACK;
    font-size: @SIZE_CAPTION;
    font-weight: 500;
    letter-spacing: 0.6px;
    padding: @SPACE_2 @SPACE_2;
    border: none;
    border-bottom: 1px solid @LINE;
}

/* QR de Banda: el código lleva su propio margen blanco (lo lee la cámara). */
QLabel[role="qr"] {
    font-family: @FONT_MONO_STACK; font-size: @SIZE_SMALL; color: @MUTED;
    border: 1px solid @LINE; border-radius: @RADIUS;
}

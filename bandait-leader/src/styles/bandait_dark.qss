/*
  Bandait DAW — Estilo OLED Noir & Neon
  Paleta profesional tipo Ableton/Studio One
*/

/* ===== BASE ===== */
QMainWindow, QWidget, QDialog {
    background-color: #000000;
    color: #F0F0F0;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
}

QFrame#panel {
    background-color: #0A0A0A;
    border: 1px solid #1E1E1E;
    border-radius: 4px;
}

QFrame#separator_v {
    background-color: #1E1E1E;
    max-width: 1px;
    min-width: 1px;
}

QFrame#separator_h {
    background-color: #1E1E1E;
    max-height: 1px;
    min-height: 1px;
}

/* ===== TÍTULOS ===== */
QLabel#title {
    font-family: "Inter", sans-serif;
    font-size: 18px;
    font-weight: bold;
    color: #00FFFF;
    letter-spacing: 1px;
}

QLabel#subtitle {
    font-family: "Inter", sans-serif;
    font-size: 12px;
    color: #666666;
}

/* ===== DISPLAYS NUMÉRICOS ===== */
QLabel#timeDisplay {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 28px;
    font-weight: bold;
    color: #CCFF00;
    background-color: #0A0A0A;
    border: 1px solid #1E1E1E;
    border-radius: 4px;
    padding: 8px 16px;
    letter-spacing: 2px;
}

QLabel#bpmDisplay {
    font-family: "JetBrains Mono", monospace;
    font-size: 32px;
    font-weight: bold;
    color: #00FFFF;
    background-color: #0A0A0A;
    border: 1px solid #1E1E1E;
    border-radius: 4px;
    padding: 4px 12px;
}

/* ===== BOTONES DE TRANSPORTE ===== */
QPushButton#transport {
    min-width: 56px;
    min-height: 56px;
    border-radius: 8px;
    font-size: 20px;
    font-weight: bold;
    border: 2px solid;
    background: transparent;
    transition: all 0.15s ease;
}

QPushButton#transport[id="play"] {
    border-color: #CCFF00;
    color: #CCFF00;
    min-width: 72px;
    min-height: 72px;
    font-size: 28px;
}

QPushButton#transport[id="play"]:checked,
QPushButton#transport[id="play"]:hover {
    background: #CCFF00;
    color: #000000;
}

QPushButton#transport[id="stop"] {
    border-color: #FF0000;
    color: #FF0000;
}

QPushButton#transport[id="stop"]:hover {
    background: #FF0000;
    color: #000000;
}

QPushButton#transport[id="rec"] {
    border-color: #FF0000;
    color: #FF0000;
    border-radius: 50%;
}

QPushButton#transport[id="rec"]:checked,
QPushButton#transport[id="rec"]:hover {
    background: #FF0000;
    color: #000000;
}

/* ===== BOTONES TOGGLE ===== */
QPushButton#toggle {
    min-width: 28px;
    min-height: 24px;
    border: 1px solid #666666;
    color: #666666;
    border-radius: 2px;
    font-size: 10px;
    font-weight: bold;
    padding: 2px;
}

QPushButton#toggle[id="mute"]:checked {
    background: #FF0000;
    border-color: #FF0000;
    color: #000000;
}

QPushButton#toggle[id="solo"]:checked {
    background: #CCFF00;
    border-color: #CCFF00;
    color: #000000;
}

QPushButton#toggle:hover {
    border-color: #00FFFF;
    color: #00FFFF;
}

/* ===== SLIDERS ===== */
QSlider::groove:vertical {
    background: #1E1E1E;
    width: 6px;
    border-radius: 3px;
}

QSlider::handle:vertical {
    background: #00FFFF;
    height: 16px;
    width: 16px;
    margin: -5px 0;
    border-radius: 2px;
}

QSlider::sub-page:vertical {
    background: #00FFFF;
    border-radius: 3px;
}

QSlider::groove:horizontal {
    background: #1E1E1E;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #00FFFF;
    width: 12px;
    height: 12px;
    margin: 0 -4px;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #00FFFF;
    border-radius: 2px;
}

/* ===== COMBOBOX ===== */
QComboBox {
    background: #0A0A0A;
    border: 1px solid #1E1E1E;
    color: #F0F0F0;
    font-size: 12px;
    padding: 4px 8px;
    border-radius: 4px;
}

QComboBox::drop-down {
    width: 20px;
    border-left: 1px solid #1E1E1E;
}

QComboBox QAbstractItemView {
    background: #0A0A0A;
    color: #F0F0F0;
    selection-background-color: #00FFFF;
    selection-color: #000000;
    border: 1px solid #1E1E1E;
}

/* ===== TAB BAR ===== */
QTabWidget::pane {
    border: none;
    background: #000000;
}

QTabBar::tab {
    background: #0A0A0A;
    color: #666666;
    padding: 10px 20px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 12px;
    font-weight: 600;
}

QTabBar::tab:selected {
    color: #00FFFF;
    border-bottom: 2px solid #00FFFF;
    background: #141414;
}

QTabBar::tab:hover:!selected {
    color: #F0F0F0;
    background: #1A1A1A;
}

/* ===== SCROLLBAR ===== */
QScrollBar:vertical {
    background: #0A0A0A;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #333333;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #555555;
}

QScrollBar:horizontal {
    background: #0A0A0A;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #333333;
    border-radius: 4px;
    min-width: 30px;
}

/* ===== MENÚ ===== */
QMenuBar {
    background: #0A0A0A;
    color: #F0F0F0;
    border-bottom: 1px solid #1E1E1E;
}

QMenuBar::item:selected {
    background: #1A1A1A;
    color: #00FFFF;
}

QMenu {
    background: #0A0A0A;
    color: #F0F0F0;
    border: 1px solid #1E1E1E;
}

QMenu::item:selected {
    background: #1A1A1A;
    color: #00FFFF;
}

/* ===== SPLITTER ===== */
QSplitter::handle {
    background: #1E1E1E;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* ===== STATUS BAR ===== */
QStatusBar {
    background: #0A0A0A;
    color: #666666;
    border-top: 1px solid #1E1E1E;
    font-size: 11px;
}

QStatusBar::item {
    border: none;
}

/* ===== INPUTS ===== */
QLineEdit {
    background: #0A0A0A;
    border: 1px solid #1E1E1E;
    color: #F0F0F0;
    padding: 6px 10px;
    border-radius: 4px;
    font-size: 13px;
}

QLineEdit:focus {
    border-color: #00FFFF;
}

/* ===== LIST VIEW / TABLE ===== */
QListView, QTableView {
    background: #0A0A0A;
    border: 1px solid #1E1E1E;
    color: #F0F0F0;
    selection-background-color: rgba(0, 255, 255, 0.2);
    selection-color: #F0F0F0;
    outline: none;
}

QListView::item:selected, QTableView::item:selected {
    background: rgba(0, 255, 255, 0.15);
    border: 1px solid #00FFFF;
}

QHeaderView::section {
    background: #141414;
    color: #888888;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #1E1E1E;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* ===== TOOLTIP ===== */
QToolTip {
    background: #141414;
    color: #F0F0F0;
    border: 1px solid #00FFFF;
    padding: 6px 10px;
    border-radius: 4px;
    font-size: 12px;
}

/* ===== PROGRESS BAR ===== */
QProgressBar {
    background: #0A0A0A;
    border: 1px solid #1E1E1E;
    border-radius: 3px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background: #00FFFF;
    border-radius: 2px;
}

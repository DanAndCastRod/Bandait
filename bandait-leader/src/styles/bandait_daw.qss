/* Bandait DAW — Design System Grafito (src/ui/theme.py) */
/* Paleta completa para DAW profesional */

/* === VARIABLES (comentarios para referencia) === */
/* bg-primary:    #15181C */
/* bg-surface:    #1B1F24 */
/* bg-elevated:   #232830 */
/* bg-hover:      #262C34 */
/* text-primary:  #D5DAE0 */
/* text-secondary:#7C8591 */
/* text-disabled: #363D47 */
/* accent-active: #5CC8C2 */
/* accent-success:#B8CF7A */
/* accent-warning:#D9A24E */
/* accent-danger: #D96459 */
/* accent-special:#B48EDB */

/* === WIDGET BASE === */
QMainWindow, QWidget {
    background-color: #15181C;
    color: #D5DAE0;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
    border: none;
}

/* === PANELES Y FRAMES === */
QFrame#panel, QGroupBox {
    background-color: #1B1F24;
    border: 1px solid #262C34;
    border-radius: 4px;
}

QFrame#elevated {
    background-color: #232830;
    border: 1px solid #262C34;
    border-radius: 4px;
}

QFrame#separator {
    background-color: #262C34;
    max-height: 1px;
    min-height: 1px;
}

QFrame#separator_v {
    background-color: #262C34;
    max-width: 1px;
    min-width: 1px;
}

/* === BARRA DE TÍTULO PERSONALIZADA === */
QFrame#titleBar {
    background-color: #1B1F24;
    border-bottom: 1px solid #262C34;
    min-height: 36px;
    max-height: 36px;
}

QLabel#titleBarTitle {
    color: #D5DAE0;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 14px;
    font-weight: 600;
}

QLabel#titleBarSubtitle {
    color: #7C8591;
    font-size: 11px;
}

/* === BOTONES === */
QPushButton {
    background-color: transparent;
    border: 2px solid #5CC8C2;
    border-radius: 4px;
    color: #5CC8C2;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
    font-weight: 500;
    padding: 8px 20px;
    min-height: 36px;
}

QPushButton:hover {
    background-color: #5CC8C2;
    color: #15181C;
}

QPushButton:pressed {
    background-color: #4AB3AD;
    border-color: #4AB3AD;
    color: #15181C;
}

QPushButton:disabled {
    border-color: #363D47;
    color: #363D47;
    background-color: transparent;
}

/* Botón de acción primaria (grabar, etc.) */
QPushButton#primary {
    background-color: #5CC8C2;
    color: #15181C;
    font-weight: 600;
}

QPushButton#primary:hover {
    background-color: #7AD6D1;
}

QPushButton#primary:pressed {
    background-color: #4AB3AD;
}

/* Botón de peligro (detener, borrar) */
QPushButton#danger {
    border-color: #D96459;
    color: #D96459;
}

QPushButton#danger:hover {
    background-color: #D96459;
    color: #15181C;
}

/* Botón de éxito (sincronizado, ok) */
QPushButton#success {
    border-color: #B8CF7A;
    color: #B8CF7A;
}

QPushButton#success:hover {
    background-color: #B8CF7A;
    color: #15181C;
}

/* Botón toggle (mute, solo) */
QPushButton#toggle {
    border-radius: 2px;
    padding: 4px 8px;
    font-size: 11px;
    min-height: 24px;
    min-width: 40px;
}

QPushButton#toggle:checked {
    background-color: #5CC8C2;
    color: #15181C;
    border-color: #5CC8C2;
}

QPushButton#toggle:checked#mute {
    background-color: #D96459;
    border-color: #D96459;
    color: #15181C;
}

QPushButton#toggle:checked#solo {
    background-color: #B8CF7A;
    border-color: #B8CF7A;
    color: #15181C;
}

/* Botón de transporte grande */
QPushButton#transport {
    min-width: 64px;
    min-height: 64px;
    border-radius: 8px;
    font-size: 24px;
    font-weight: bold;
}

QPushButton#transport#play {
    border-color: #B8CF7A;
    color: #B8CF7A;
}

QPushButton#transport#play:hover {
    background-color: #B8CF7A;
    color: #15181C;
}

QPushButton#transport#play:checked {
    background-color: #B8CF7A;
    color: #15181C;
}

QPushButton#transport#stop {
    border-color: #D96459;
    color: #D96459;
}

QPushButton#transport#stop:hover {
    background-color: #D96459;
    color: #15181C;
}

QPushButton#transport#rec {
    border-color: #D96459;
    color: #D96459;
    border-radius: 50%;
}

QPushButton#transport#rec:hover {
    background-color: #D96459;
    color: #15181C;
}

QPushButton#transport#rec:checked {
    background-color: #D96459;
    color: #15181C;
    animation: pulse 1s infinite;
}

/* === SLIDERS / FADERS === */
QSlider::groove:vertical {
    background-color: #262C34;
    width: 8px;
    border-radius: 4px;
}

QSlider::handle:vertical {
    background-color: #5CC8C2;
    border: none;
    height: 24px;
    width: 24px;
    margin: 0 -8px;
    border-radius: 2px;
}

QSlider::handle:vertical:hover {
    background-color: #7AD6D1;
}

QSlider::sub-page:vertical {
    background-color: #5CC8C2;
    border-radius: 4px;
}

QSlider::add-page:vertical {
    background-color: #1B1F24;
    border-radius: 4px;
}

QSlider::groove:horizontal {
    background-color: #262C34;
    height: 8px;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background-color: #5CC8C2;
    border: none;
    width: 24px;
    height: 24px;
    margin: -8px 0;
    border-radius: 2px;
}

QSlider::handle:horizontal:hover {
    background-color: #7AD6D1;
}

QSlider::sub-page:horizontal {
    background-color: #5CC8C2;
    border-radius: 4px;
}

QSlider::add-page:horizontal {
    background-color: #1B1F24;
    border-radius: 4px;
}

/* === LINE EDITS === */
QLineEdit {
    background-color: #1B1F24;
    border: 1px solid #262C34;
    border-radius: 4px;
    color: #D5DAE0;
    padding: 8px 12px;
    font-size: 13px;
}

QLineEdit:focus {
    border-color: #5CC8C2;
}

QLineEdit:disabled {
    background-color: #232830;
    color: #363D47;
}

/* === COMBO BOX === */
QComboBox {
    background-color: #1B1F24;
    border: 1px solid #262C34;
    border-radius: 4px;
    color: #D5DAE0;
    padding: 8px 12px;
    font-size: 13px;
    min-width: 120px;
}

QComboBox:hover {
    border-color: #363D47;
}

QComboBox:focus {
    border-color: #5CC8C2;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #7C8591;
    width: 0;
    height: 0;
}

QComboBox QAbstractItemView {
    background-color: #1B1F24;
    border: 1px solid #262C34;
    color: #D5DAE0;
    selection-background-color: #5CC8C2;
    selection-color: #15181C;
}

/* === LIST WIDGET / TREE === */
QListWidget, QTreeWidget {
    background-color: #1B1F24;
    border: 1px solid #262C34;
    border-radius: 4px;
    color: #D5DAE0;
    outline: none;
}

QListWidget::item, QTreeWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #232830;
}

QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: #232830;
}

QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #5CC8C2;
    color: #15181C;
}

/* === TAB BAR === */
QTabBar::tab {
    background-color: #1B1F24;
    color: #7C8591;
    padding: 10px 20px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 13px;
    font-weight: 500;
}

QTabBar::tab:hover {
    color: #D5DAE0;
    background-color: #232830;
}

QTabBar::tab:selected {
    color: #5CC8C2;
    border-bottom: 2px solid #5CC8C2;
    background-color: #232830;
}

QTabWidget::pane {
    background-color: #15181C;
    border: none;
}

/* === SCROLL BAR === */
QScrollBar:vertical {
    background-color: #1B1F24;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #363D47;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #7C8591;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #1B1F24;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #363D47;
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #7C8591;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* === MENÚ === */
QMenuBar {
    background-color: #1B1F24;
    color: #D5DAE0;
    border-bottom: 1px solid #262C34;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
}

QMenuBar::item:selected {
    background-color: #232830;
    color: #5CC8C2;
}

QMenu {
    background-color: #1B1F24;
    border: 1px solid #262C34;
    color: #D5DAE0;
}

QMenu::item {
    padding: 8px 24px;
}

QMenu::item:selected {
    background-color: #5CC8C2;
    color: #15181C;
}

/* === TOOLTIP === */
QToolTip {
    background-color: #232830;
    color: #D5DAE0;
    border: 1px solid #262C34;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}

/* === DISPLAYS NUMÉRICOS (BPM, tiempo, etc.) === */
QLabel#numericDisplay {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 48px;
    font-weight: bold;
    color: #5CC8C2;
    background-color: #1B1F24;
    border: 1px solid #262C34;
    border-radius: 4px;
    padding: 8px 16px;
    qproperty-alignment: AlignCenter;
}

QLabel#numericDisplaySmall {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 24px;
    font-weight: bold;
    color: #D5DAE0;
}

QLabel#timeDisplay {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 32px;
    font-weight: bold;
    color: #B8CF7A;
    background-color: #1B1F24;
    border: 1px solid #262C34;
    border-radius: 4px;
    padding: 4px 12px;
    qproperty-alignment: AlignCenter;
}

/* === VU METER === */
QProgressBar#vuMeter {
    background-color: #1B1F24;
    border: 1px solid #262C34;
    border-radius: 2px;
    text-align: center;
    color: transparent;
}

QProgressBar#vuMeter::chunk {
    border-radius: 2px;
}

QProgressBar#vuMeter::chunk:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #5CC8C2,
        stop:0.6 #B8CF7A,
        stop:0.85 #D9A24E,
        stop:1 #D96459);
}

QProgressBar#vuMeter::chunk:vertical {
    background: qlineargradient(x1:0, y1:1, x2:0, y2:0,
        stop:0 #5CC8C2,
        stop:0.6 #B8CF7A,
        stop:0.85 #D9A24E,
        stop:1 #D96459);
}

/* === LED INDICATORS === */
QLabel#led {
    min-width: 12px;
    max-width: 12px;
    min-height: 12px;
    max-height: 12px;
    border-radius: 6px;
    background-color: #363D47;
}

QLabel#led#ledOn {
    background-color: #B8CF7A;
    box-shadow: 0 0 8px #B8CF7A;
}

QLabel#led#ledRec {
    background-color: #D96459;
    box-shadow: 0 0 8px #D96459;
}

QLabel#led#ledSync {
    background-color: #5CC8C2;
    box-shadow: 0 0 8px #5CC8C2;
}

QLabel#led#ledWarn {
    background-color: #D9A24E;
    box-shadow: 0 0 8px #D9A24E;
}

/* === DIAL / KNOB === */
QDial {
    background-color: transparent;
}

/* === STATUS BAR === */
QStatusBar {
    background-color: #1B1F24;
    color: #7C8591;
    border-top: 1px solid #262C34;
    font-size: 11px;
}

QStatusBar QLabel {
    padding: 2px 8px;
}

/* === TOOLBAR === */
QToolBar {
    background-color: #1B1F24;
    border: none;
    spacing: 4px;
    padding: 4px;
}

QToolBar QToolButton {
    background-color: transparent;
    border: 1px solid #262C34;
    border-radius: 4px;
    padding: 6px;
    color: #7C8591;
}

QToolBar QToolButton:hover {
    background-color: #232830;
    color: #D5DAE0;
    border-color: #363D47;
}

QToolBar QToolButton:pressed {
    background-color: #5CC8C2;
    color: #15181C;
}

/* === TABLE === */
QTableWidget {
    background-color: #1B1F24;
    border: 1px solid #262C34;
    color: #D5DAE0;
    gridline-color: #232830;
    outline: none;
}

QTableWidget::item {
    padding: 6px 10px;
    border-bottom: 1px solid #232830;
}

QTableWidget::item:selected {
    background-color: #5CC8C2;
    color: #15181C;
}

QHeaderView::section {
    background-color: #232830;
    color: #7C8591;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #262C34;
    font-weight: 600;
    font-size: 12px;
}

/* === SPLITTER === */
QSplitter::handle {
    background-color: #262C34;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #5CC8C2;
}

/* === DIALOG === */
QDialog {
    background-color: #15181C;
    border: 1px solid #262C34;
}

/* === CHECKBOX === */
QCheckBox {
    color: #D5DAE0;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #7C8591;
    border-radius: 3px;
    background-color: transparent;
}

QCheckBox::indicator:checked {
    background-color: #5CC8C2;
    border-color: #5CC8C2;
}

QCheckBox::indicator:hover {
    border-color: #5CC8C2;
}

/* === RADIO BUTTON === */
QRadioButton {
    color: #D5DAE0;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #7C8591;
    border-radius: 9px;
    background-color: transparent;
}

QRadioButton::indicator:checked {
    background-color: #5CC8C2;
    border-color: #5CC8C2;
}

/* === SPIN BOX === */
QSpinBox, QDoubleSpinBox {
    background-color: #1B1F24;
    border: 1px solid #262C34;
    border-radius: 4px;
    color: #D5DAE0;
    padding: 6px;
    font-family: "JetBrains Mono", "Consolas", monospace;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #5CC8C2;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #232830;
    border: none;
    width: 20px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #262C34;
}

/* === TEXT EDIT === */
QTextEdit {
    background-color: #1B1F24;
    border: 1px solid #262C34;
    border-radius: 4px;
    color: #D5DAE0;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 13px;
    padding: 8px;
}

QTextEdit:focus {
    border-color: #5CC8C2;
}

/* === GROUP BOX === */
QGroupBox {
    border: 1px solid #262C34;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 12px;
    font-weight: 600;
    color: #7C8591;
    font-size: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px;
}

/* === NOTIFICATION / TOAST === */
QFrame#toast {
    background-color: #232830;
    border: 1px solid #262C34;
    border-radius: 8px;
    padding: 12px 16px;
}

QLabel#toastText {
    color: #D5DAE0;
    font-size: 13px;
}

QLabel#toastIcon {
    font-size: 16px;
    min-width: 24px;
}

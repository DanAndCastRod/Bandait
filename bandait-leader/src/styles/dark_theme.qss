/* Bandait Leader — Grafito Theme (QSS, src/ui/theme.py) */

QMainWindow, QWidget {
    background-color: #15181C;
    color: #D5DAE0;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 14px;
}

QLabel {
    color: #D5DAE0;
}

QLabel#bpmDisplay {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 64px;
    font-weight: bold;
    color: #5CC8C2;
}

QLabel#statusLabel {
    font-family: "JetBrains Mono", monospace;
    font-size: 24px;
    font-weight: bold;
    color: #B8CF7A;
    text-transform: uppercase;
}

QLabel#infoLabel {
    color: #7C8591;
    font-size: 12px;
}

QPushButton {
    background: transparent;
    border: 2px solid #5CC8C2;
    border-radius: 4px;
    color: #5CC8C2;
    min-width: 120px;
    min-height: 56px;
    font-weight: bold;
    font-size: 16px;
}

QPushButton:hover {
    background: #5CC8C2;
    color: #15181C;
}

QPushButton:pressed {
    background: #5CC8C2;
    color: #15181C;
}

QPushButton#actionPadDanger {
    border-color: #D96459;
    color: #D96459;
}

QPushButton#actionPadDanger:hover {
    background: #D96459;
    color: #15181C;
}

QPushButton#actionPadRecord {
    border-color: #B48EDB;
    color: #B48EDB;
}

QPushButton#actionPadRecord:hover {
    background: #B48EDB;
    color: #15181C;
}

QTabWidget::pane {
    border: 1px solid #232830;
    background: #15181C;
}

QTabBar::tab {
    background: #1B1F24;
    color: #7C8591;
    padding: 12px 24px;
    border: none;
    font-weight: bold;
}

QTabBar::tab:selected {
    background: #15181C;
    color: #5CC8C2;
    border-bottom: 2px solid #5CC8C2;
}

QTabBar::tab:hover {
    color: #D5DAE0;
}

QLabel#sectionTitle {
    font-family: "JetBrains Mono", monospace;
    font-size: 18px;
    font-weight: bold;
    color: #B8CF7A;
    text-transform: uppercase;
    padding-bottom: 8px;
}

QLabel#stagePlaceholder {
    font-family: "JetBrains Mono", monospace;
    font-size: 24px;
    color: #5CC8C2;
}

QListWidget {
    background: #1B1F24;
    border: 1px solid #232830;
    color: #D5DAE0;
    outline: none;
}

QListWidget::item:selected {
    background: #232830;
    color: #5CC8C2;
    border-left: 3px solid #5CC8C2;
}

QListWidget::item:hover {
    background: #232830;
}

QLineEdit, QTextEdit, QSpinBox, QComboBox, QDateTimeEdit {
    background: #1B1F24;
    border: 1px solid #363D47;
    color: #D5DAE0;
    padding: 8px;
    border-radius: 4px;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QComboBox:focus, QDateTimeEdit:focus {
    border: 1px solid #5CC8C2;
}

QSplitter::handle {
    background: #232830;
    width: 2px;
}

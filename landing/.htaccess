<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Redireccion obligatoria a HTTPS (Requerido para PWA y Web Audio en movil)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Rutas SPA para Web Admin Hub (/hub/* -> /hub/index.html)
  RewriteCond %{REQUEST_URI} ^/hub/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^hub/(.*)$ /hub/index.html [L]

  # 3. Rutas SPA para Follower PWA (/app/* -> /app/index.html)
  RewriteCond %{REQUEST_URI} ^/app/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^app/(.*)$ /app/index.html [L]

  # 4. Compresion Gzip para carga instantanea en escenario
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/manifest+json
  </IfModule>

  # 5. Politicas de Cache para Service Worker y Assets
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
  </IfModule>
</IfModule>
